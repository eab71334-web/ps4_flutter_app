#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <orbis/libkernel.h>
#include <orbis/UserService.h>

#define PORT 9025
#define BUFFER_SIZE 1024

// وظيفة التعامل مع الأوامر القادمة من الآيفون
void handle_client_command(int client_socket) {
    char buffer[BUFFER_SIZE] = {0};
    read(client_socket, buffer, BUFFER_SIZE);
    printf("[PS4 Server] Received signal: %s\n", buffer);

    if (strstr(buffer, "WAKE_PING") != NULL) {
        char *response = "PS4_HOST_ACTIVE_GOLDHEN_READY";
        send(client_socket, response, strlen(response), 0);
    } 
    else if (strstr(buffer, "INSTALL_PKG") != NULL) {
        // أمر تنصيب حزمة PKG تلقائياً عبر GoldHEN Package Installer API
        char *response = "PKG_INSTALL_TRIGGERED";
        send(client_socket, response, strlen(response), 0);
    }
    else if (strstr(buffer, "START_STREAM") != NULL) {
        // تهيئة البث المباشر وقنوات الـ Low-Latency Video Pipeline
        char *response = "STREAM_PIPELINE_OK";
        send(client_socket, response, strlen(response), 0);
    }
    close(client_socket);
}

int main() {
    int server_fd, new_socket;
    struct sockaddr_in address;
    int opt = 1;
    int addrlen = sizeof(address);

    // إنشاء Socket مخصص لاتصال P2P من الآيفون
    if ((server_fd = socket(AF_INET, SOCK_STREAM, 0)) == 0) {
        return -1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
        return -1;
    }

    if (listen(server_fd, 3) < 0) {
        return -1;
    }

    printf("[PS4 Host Server] Listening on Port %d...\n", PORT);

    while(1) {
        if ((new_socket = accept(server_fd, (struct sockaddr *)&address, (socklen_t*)&addrlen)) >= 0) {
            handle_client_command(new_socket);
        }
        sceKernelUsleep(10000); // تقليل استهلاك المعالج في الخلفية
    }

    return 0;
}
